{
  "info": {
    "_postman_id": "ats-backend-collection",
    "name": "ATS Backend API",
    "description": "Complete API collection for AI-powered Applicant Tracking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "REFRESH_TOKEN",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    console.log('Registration successful');",
                  "    pm.environment.set('USER_ID', pm.response.json().data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"John Recruiter\\\",\\n  \\\"email\\\": \\\"recruiter@company.com\\\",\\n  \\\"password\\\": \\\"SecurePass123\\\",\\n  \\\"role\\\": \\\"recruiter\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json().data;",
                  "    pm.environment.set('ACCESS_TOKEN', data.accessToken);",
                  "    pm.environment.set('REFRESH_TOKEN', data.refreshToken);",
                  "    console.log('Login successful');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"email\\\": \\\"recruiter@company.com\\\",\\n  \\\"password\\\": \\\"SecurePass123\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"refreshToken\\\": \\\"{{REFRESH_TOKEN}}\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/refresh-token",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "refresh-token"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/profile",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"oldPassword\\\": \\\"SecurePass123\\\",\\n  \\\"newPassword\\\": \\\"NewSecurePass123\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/change-password",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"title\\\": \\\"Senior Full Stack Engineer\\\",\\n  \\\"description\\\": \\\"We are looking for an experienced Full Stack Engineer with expertise in Node.js and React.\\\",\\n  \\\"requiredSkills\\\": [\\\"Node.js\\\", \\\"React\\\", \\\"MongoDB\\\", \\\"TypeScript\\\"],\\n  \\\"preferredSkills\\\": [\\\"Docker\\\", \\\"AWS\\\", \\\"GraphQL\\\"],\\n  \\\"minimumExperience\\\": 5,\\n  \\\"educationRequirement\\\": \\\"bachelors\\\",\\n  \\\"location\\\": \\\"San Francisco, CA\\\",\\n  \\\"jobType\\\": \\\"full_time\\\",\\n  \\\"salary\\\": {\\n    \\\"min\\\": 150000,\\n    \\\"max\\\": 200000,\\n    \\\"currency\\\": \\\"USD\\\"\\n  }\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/jobs",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "jobs"]
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/jobs?page=1&limit=20&status=open",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "jobs"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            }
          }
        },
        {
          "name": "Get Job Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/jobs/{{JOB_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "jobs", "{{JOB_ID}}"]
            }
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"title\\\": \\\"Senior Full Stack Engineer (Updated)\\\",\\n  \\\"status\\\": \\\"open\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/jobs/{{JOB_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "jobs", "{{JOB_ID}}"]
            }
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/jobs/{{JOB_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "jobs", "{{JOB_ID}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "List Candidates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/candidates?page=1&limit=20&status=applied",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "candidates"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "applied"
                }
              ]
            }
          }
        },
        {
          "name": "Get Candidate Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/candidates/{{CANDIDATE_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "candidates", "{{CANDIDATE_ID}}"]
            }
          }
        },
        {
          "name": "Create Candidate Manually",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"name\\\": \\\"Jane Developer\\\",\\n  \\\"email\\\": \\\"jane@example.com\\\",\\n  \\\"phone\\\": \\\"+1-555-0100\\\",\\n  \\\"location\\\": \\\"New York, NY\\\",\\n  \\\"experience\\\": {\\n    \\\"totalYears\\\": 6\\n  },\\n  \\\"education\\\": {\\n    \\\"collegeName\\\": \\\"MIT\\\",\\n    \\\"course\\\": \\\"Computer Science\\\",\\n    \\\"passingYear\\\": 2018,\\n    \\\"cgpa\\\": 3.8\\n  },\\n  \\\"skills\\\": [\\\"Node.js\\\", \\\"React\\\", \\\"MongoDB\\\", \\\"TypeScript\\\"],\\n  \\\"resumeUrl\\\": \\\"https://example.com/resume.pdf\\\",\\n  \\\"resumeText\\\": \\\"Jane Developer...\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/candidates",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "candidates"]
            }
          }
        },
        {
          "name": "Update Candidate Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"status\\\": \\\"shortlisted\\\"\\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/candidates/{{CANDIDATE_ID}}/status",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "candidates", "{{CANDIDATE_ID}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Matching",
      "item": [
        {
          "name": "Start Matching for Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/matching/job/{{JOB_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "matching", "job", "{{JOB_ID}}"]
            }
          }
        },
        {
          "name": "Get Matching Results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/matching/job/{{JOB_ID}}/results?page=1&limit=20",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "matching", "job", "{{JOB_ID}}", "results"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/health",
          "host": ["{{BASE_URL}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
