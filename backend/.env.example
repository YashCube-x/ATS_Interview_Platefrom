# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster0.xxxxxx.mongodb.net/<DB_NAME>

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_64_chars
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ats-index
PINECONE_ENVIRONMENT=us-east-1-aws

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# Gmail API (OAuth2)
GMAIL_CLIENT_ID=your_google_oauth2_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth2_refresh_token
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_USER_EMAIL=your_gmail_address@gmail.com

# SMTP Configuration (for Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Email Configuration
EMAIL_FROM=your_email@gmail.com
EMAIL_SUPPORT=your_support_email@gmail.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Resume Processing
MAX_RESUME_FILE_SIZE=5242880
SUPPORTED_RESUME_FORMATS=pdf,docx

# Matching Engine (weights must sum to 1.0)
SEMANTIC_WEIGHT=0.4
SKILL_WEIGHT=0.3
EXPERIENCE_WEIGHT=0.15
PROJECT_WEIGHT=0.1
EDUCATION_WEIGHT=0.05

# Pinecone Batch Size
PINECONE_BATCH_SIZE=100
PINECONE_TOP_CANDIDATES=100
